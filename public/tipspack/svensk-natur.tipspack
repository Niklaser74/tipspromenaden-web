      "correctOptionIndex": 3
    },
    {
      "text": "Vilken fisk räknas som Sveriges nationalfisk?",
      "options": ["Sik", "Abborre", "Lax", "Gädda"],
      "correctOptionIndex": 1
    },
    {
      "text": "Vilken är Sveriges största nationalpark till ytan?",
      "options": ["Tyresta", "Padjelanta", "Abisko", "Sarek"],
      "correctOptionIndex": 1
    },
    {
      "text": "Vilket bär har högst halt av C-vitamin per gram?",
