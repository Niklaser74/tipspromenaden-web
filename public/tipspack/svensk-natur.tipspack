      "correctOptionIndex": 2
    },
    {
      "text": "Vilket är Sveriges största landlevande däggdjur?",
      "options": ["Björn", "Älg", "Vildsvin", "Ren"],
      "correctOptionIndex": 1
    },
    {
      "text": "Vilken fågel är Sveriges nationalfågel?",
