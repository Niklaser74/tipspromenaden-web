        "Äpple",
        "Banan",
        "Päron",
        "Apelsin"
      ],
      "correctOptionIndex": 1
    },
    {
      "text": "Vilken färg har ett vattenmelon på insidan?",
      "options": [
        "Gul",
        "Grön",
        "Röd",
        "Blå"
      ],
      "correctOptionIndex": 2
    },
    {
      "text": "Vilket litet bär är rött och växer på sommaren i Sverige?",
      "options": [
        "Blåbär",
        "Jordgubbe",
        "Vindruva",
        "Kiwi"
      ],
      "correctOptionIndex": 1
    },
    {
      "text": "Vad finns inuti en persika?",
      "options": [
        "En stor hård kärna",
        "Många små frön",
        "Ingenting",
        "En liten nöt"
      ],
      "correctOptionIndex": 0
    },
    {
      "text": "Vilken frukt måste man skala innan man äter den?",
      "options": [
        "Äpple",
        "Päron",
        "Apelsin",
        "Plommon"
      ],
      "correctOptionIndex": 2
    },
    {
      "text": "Vad heter den gröna frukten som är lurvig på utsidan och grön inuti?",
