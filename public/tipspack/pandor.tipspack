  "name": "Pandor",
  "description": "15 roliga frågor om jättepandor – perfekt för alla som älskar dessa svartvita björnar!",
  "author": "Niklas Eriksson",
  "questions": [
    {
      "text": "Vad äter jättepandor allra mest av?",
      "options": [
        "Gräs",
        "Bambu",
        "Blåbär",
        "Löv från ekträd"
      ],
      "correctOptionIndex": 1
    },
    {
      "text": "I vilket land lever vilda jättepandor?",
      "options": [
        "Japan",
        "Indien",
        "Kina",
        "Thailand"
      ],
      "correctOptionIndex": 2
    },
    {
      "text": "Ungefär hur mycket kan en vuxen jättepanda väga?",
      "options": [
        "30–50 kg",
        "70–120 kg",
        "200–250 kg",
        "400–500 kg"
      ],
      "correctOptionIndex": 1
    },
    {
      "text": "Hur mycket bambu kan en jättepanda äta per dag?",
      "options": [
        "Upp till 5 kg",
        "Upp till 15 kg",
        "Upp till 38 kg",
        "Upp till 60 kg"
      ],
      "correctOptionIndex": 2
    },
    {
      "text": "Vilken färg har en nyfödd pandaunge?",
      "options": [
        "Svartvit precis som en vuxen",
        "Helt svart",
        "Rosa och nästan hårlös",
        "Brun med vita fläckar"
      ],
      "correctOptionIndex": 2
    },
    {
      "text": "Hur stor är en nyfödd pandaunge jämfört med sin mamma?",
      "options": [
        "Ungefär hälften så stor",
