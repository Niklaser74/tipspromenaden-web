---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import UpcomingEventsTeaser from "../../components/UpcomingEventsTeaser.tsx";
import appIcon from "../../assets/icon.png";
import skarmHem from "../../assets/screenshots/skarm-hem.jpg";
import skarmGaMed from "../../assets/screenshots/skarm-ga-med.jpg";
import skarmAktiv from "../../assets/screenshots/skarm-aktiv.jpg";

// App is live on BOTH stores (Android since 2026-05-17, iOS since
// 2026-05-24). CTA shows both buttons side-by-side.
const PLAY_STORE_URL =
  "https://play.google.com/store/apps/details?id=com.tipspromenaden.app";
const APP_STORE_URL = "https://apps.apple.com/se/app/id6770503457";

// FAQ — common questions answered in a structured way. The same data
// drives both the visible section and the FAQPage schema in <head>, so
// answers can be extracted directly by LLMs and Google (GEO/AEO).
const faq = [
  {
    q: "Is internet required?",
    a: "You need internet to download the walk the first time. After that it works offline if you lose signal outdoors — GPS unlocks the questions locally.",
  },
  {
    q: "How many participants can join?",
    a: "Unlimited. Anyone with the link or who scans the QR code can walk at the same time and appears on the same live leaderboard.",
  },
  {
    q: "What does the app cost?",
    a: "Nothing. Tipspromenaden is completely free with no ads and no in-app purchases — it runs as a hobby project.",
  },
  {
    q: "Do I need to log in to take part?",
    a: "No. As a participant you only enter a name. Signing in with Google is required only if you want to create your own walks.",
  },
  {
    q: "Which devices and platforms are supported?",
    a: "The app is available for both iPhone (iOS) and Android. You can also create walks in your browser on a computer or iPad at /skapa.",
  },
  {
    q: "How do I share a walk with others?",
    a: "Once you save a walk you automatically get a QR code and a link. Print the QR code or share the link — participants need no account.",
  },
  {
    q: "Which languages does the app support?",
    a: "Swedish, English, German, Norwegian, Danish, Finnish, French and Spanish. The app can follow the system language or be set manually.",
  },
];

// FAQPage schema built from the same faq array — passed to Layout,
// which renders it as a JSON-LD block in <head>.
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
};

const screenshots = [
  {
    src: skarmHem,
    alt: "Home screen showing the Tipspromenaden header, a Create walk button and a list of saved walks",
    caption: "Your collection of walks",
  },
  {
    src: skarmGaMed,
    alt: "Join screen where a participant types their name to start an ongoing walk",
    caption: "Type a name — join an ongoing round",
  },
  {
    src: skarmAktiv,
    alt: "Map showing 13 numbered control points and the distance to the next checkpoint",
    caption: "GPS shows where the next checkpoint is",
  },
];
---

<Layout
  title="Tipspromenaden — quiz walks in your pocket"
  description="Free app for creating and joining outdoor quiz walks. Checkpoints on a map, questions unlocked by GPS, and a live leaderboard."
  lang="en"
  alternateUrl="/"
  jsonLd={[faqJsonLd]}
>
  <main class="min-h-screen">
    {/* ─── HERO ──────────────────────────────────────────── */}
    <section class="max-w-3xl mx-auto px-6 pt-20 pb-12 text-center">
      <p class="text-sm tracking-[0.25em] text-sage uppercase mb-4">
        Quiz walk in your pocket
      </p>
      <hr class="w-12 border-t border-green mx-auto mb-12" />

      {/* Optimized app icon — Astro generates small webp variants
          (128/256px) instead of shipping the 1024px source PNG.
          fetchpriority=high + eager loading since the icon is above
          the fold and is often the LCP element on mobile. */}
      <Image
        src={appIcon}
        alt="The Tipspromenaden app icon"
        width={128}
        height={128}
        densities={[1, 2]}
        loading="eager"
        fetchpriority="high"
        class="w-28 h-28 mx-auto rounded-3xl mb-10 shadow-sm"
      />

      <h1 class="font-serif font-bold text-4xl sm:text-6xl md:text-7xl text-green-dark leading-none mb-6">
        Tipspromenaden
      </h1>
      <p class="font-serif italic text-lg sm:text-xl md:text-2xl text-green">
        An outdoor quiz walk — with your phone as the question paper.
      </p>
    </section>

    {/* ─── UPCOMING EVENTS ───────────────────────────────────
        Realtime fetch from Firestore via React island. Renders only
        when public walks with event dates within 30 days exist;
        otherwise the whole section disappears. */}
    <UpcomingEventsTeaser client:idle lang="en" />

    {/* (Previously here: iPhone banner "Support the project and we'll
        release the iOS version" — removed 2026-05-24 when the iOS
        launch was complete. The CTA section further down now shows
        both store buttons.) */}

    {/* ─── INTRO ─────────────────────────────────────────── */}
    <section class="max-w-2xl mx-auto px-6 pb-16 text-center">
      <p class="text-lg leading-relaxed">
        The creator draws checkpoints on a map and links a question to
        each one. Participants scan the QR code and walk to each
        checkpoint with GPS — the question unlocks automatically when
        they arrive. The family outing suddenly becomes a friendly
        competition.
      </p>
    </section>

    {/* Hairline */}
    <hr class="w-24 border-t border-rule mx-auto mb-20" />

    {/* ─── FEATURES ──────────────────────────────────────── */}
    <section class="max-w-5xl mx-auto px-6 pb-20 grid md:grid-cols-3 gap-12">
      {[
        {
          title: "Build it yourself",
          body: "Map, questions, images, QR code — in minutes. Or import a ready-made question pack."
        },
        {
          title: "GPS unlocks the questions",
          body: "No one can skip a checkpoint. Competitive feel without stress, anti-cheat without friction."
        },
        {
          title: "Live leaderboard",
          body: "The whole family competes simultaneously and everyone sees the standings. Average steps, average score and answer distribution for the creator."
        }
      ].map(({ title, body }) => (
        <div class="text-center md:text-left">
          {/* Diamond marker in the Friluft Folio spirit */}
          <div class="inline-block w-3 h-3 bg-green rotate-45 mb-4"></div>
          <h3 class="font-serif font-bold text-2xl mb-3">{title}</h3>
          <p class="text-base leading-relaxed">{body}</p>
        </div>
      ))}
    </section>

    {/* ─── SCREENSHOTS ──────────────────────────────────── */}
    <section class="max-w-6xl mx-auto pb-24">
      <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl text-center mb-12 px-6">
        How it looks
      </h2>

      <div
        class="flex md:grid md:grid-cols-3 gap-6 md:gap-12 overflow-x-auto md:overflow-visible snap-x snap-mandatory scroll-smooth px-6 md:px-6 pb-6 md:pb-0 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      >
        {screenshots.map(({ src, alt, caption }) => (
          <figure class="snap-center shrink-0 w-[260px] md:w-auto mx-auto text-center">
            <div class="bg-white rounded-2xl ring-1 ring-rule shadow-lg shadow-green-dark/15 overflow-hidden">
              <Image
                src={src}
                alt={alt}
                widths={[260, 320, 480, 640]}
                sizes="(min-width: 768px) 320px, 260px"
                class="w-full h-auto block"
                loading="lazy"
              />
            </div>
            <figcaption class="mt-4 text-sm font-serif italic text-sage">
              {caption}
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    {/* ─── HOW TO CREATE YOUR FIRST WALK ──────────────────────
        In-depth content about the user journey — gives AI models and
        new users concrete, step-by-step context on how the app is
        actually used. Ordered list so the steps can be extracted. */}
    <section class="max-w-2xl mx-auto px-6 pb-20">
      <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl text-center mb-4">
        How to create your first quiz walk
      </h2>
      <p class="text-base leading-relaxed text-center text-text-warm mb-10 max-w-xl mx-auto">
        Going from an empty map to a finished QR code takes a few minutes.
        Build it in the app on location or at your desk via
        <a href="/en/skapa" class="text-green underline">tipspromenaden.app/skapa</a>.
      </p>
      <ol class="space-y-6">
        {[
          {
            title: "Create a walk and pick the location",
            body: "Tap Create walk and sign in with Google. Zoom the map to the park, schoolyard or neighbourhood where the walk will take place.",
          },
          {
            title: "Place checkpoints on the map",
            body: "Tap where each checkpoint should be — the app numbers them automatically. A typical family walk has 8–13 checkpoints over 1–3 km.",
          },
          {
            title: "Write questions and answer options",
            body: "Link a question to each checkpoint, add answer options and mark the correct one. You can upload an image per question, or import a ready-made question pack from the library.",
          },
          {
            title: "Choose activity type and event mode",
            body: "Walking (15 m GPS trigger) or cycling (50 m with an early warning). Set a start and end date if everyone should compete in the same round with a shared leaderboard.",
          },
          {
            title: "Share the QR code",
            body: "Save and you get a QR code and a link. Print the code at the starting point or share the link — participants need no account or login to play.",
          },
        ].map(({ title, body }, i) => (
          <li class="flex gap-4">
            <span class="shrink-0 w-9 h-9 rounded-full bg-green-dark text-cream font-serif font-bold flex items-center justify-center">
              {i + 1}
            </span>
            <div>
              <h3 class="font-serif font-bold text-xl mb-1">{title}</h3>
              <p class="text-base leading-relaxed text-text-warm">{body}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="text-sm text-sage italic text-center mt-10">
        Want the full step-by-step guide for both creators and
        participants? Read <a href="/en/how-it-works" class="text-green underline not-italic">How it works</a>.
      </p>
    </section>

    {/* ─── USE CASES ──────────────────────────────────────────
        Concrete scenarios — helps both visitors and AI understand
        what the app is used for. Bullet list optimised for extraction. */}
    <section class="max-w-3xl mx-auto px-6 pb-20">
      <h2 class="font-serif text-2xl sm:text-3xl text-center mb-8">
        Perfect for
      </h2>
      <ul class="grid sm:grid-cols-2 gap-x-10 gap-y-4 max-w-2xl mx-auto list-disc pl-5 marker:text-green">
        <li class="text-base leading-relaxed"><strong>Schools and after-school care</strong> — educational outdoor activities where questions tie into nature or the local area.</li>
        <li class="text-base leading-relaxed"><strong>Family parties and birthdays</strong> — a friendly competition that gets all ages moving.</li>
        <li class="text-base leading-relaxed"><strong>Hen and stag parties</strong> — build a fun route with personal questions about the couple.</li>
        <li class="text-base leading-relaxed"><strong>Company kickoffs and team building</strong> — teams compete against each other with a live leaderboard.</li>
        <li class="text-base leading-relaxed"><strong>Clubs and events</strong> — publish the walk so everyone in the area can take part.</li>
        <li class="text-base leading-relaxed"><strong>Tourist trails</strong> — guide visitors between sights with questions about each place.</li>
      </ul>
    </section>

    {/* ─── CTA ───────────────────────────────────────────── */}
    <section class="max-w-3xl mx-auto px-6 pb-20">
      <div class="bg-green-dark text-cream rounded-3xl p-10 md:p-14 text-center">
        <p class="text-sm tracking-[0.25em] uppercase text-cta-body mb-3">
          Free on App Store and Google Play
        </p>
        <h2 class="font-serif text-cream text-3xl sm:text-4xl md:text-5xl mb-6">
          Download and get started
        </h2>
        <p class="text-cta-body text-lg mb-10 max-w-xl mx-auto leading-relaxed">
          Tipspromenaden is available for both iPhone and Android —
          completely free. Create your own quiz walk or scan a QR code
          and start walking right away.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center items-center max-w-xl mx-auto">
          <a
            href={APP_STORE_URL}
            class="inline-block bg-cream text-green-dark font-semibold text-lg px-8 py-4 rounded-xl hover:bg-white transition-colors w-full sm:w-auto"
          >
            🍏 Get it on App Store
          </a>
          <a
            href={PLAY_STORE_URL}
            class="inline-block bg-cream text-green-dark font-semibold text-lg px-8 py-4 rounded-xl hover:bg-white transition-colors w-full sm:w-auto"
          >
            🤖 Get it on Google Play
          </a>
        </div>
        <p class="text-cta-body text-sm mt-6 max-w-md mx-auto leading-relaxed opacity-80">
          Want to support the project? See{" "}
          <a href="/en/support" class="underline">Support us</a>.
        </p>
        <div class="w-14 h-1 bg-yellow mx-auto mt-8"></div>
      </div>
    </section>

    {/* ─── Secondary links — tipspack + create ────────────── */}
    <section class="max-w-3xl mx-auto px-6 pb-16">
      <div class="grid md:grid-cols-2 gap-4">
        <a
          href="/en/tipspack"
          class="block bg-white border border-rule rounded-2xl p-6 hover:border-green-dark transition"
        >
          <h3 class="font-serif text-2xl text-green-dark mb-2">
            Ready-made question packs
          </h3>
          <p class="text-text-warm text-sm leading-relaxed">
            Download free question collections — Stockholm Old Town, Visby,
            pop culture, science and more. Import directly into the app.
          </p>
          <p class="mt-3 text-green font-semibold text-sm">
            Browse the library →
          </p>
        </a>
        <a
          href="/en/skapa"
          class="block bg-white border border-rule rounded-2xl p-6 hover:border-green-dark transition"
        >
          <h3 class="font-serif text-2xl text-green-dark mb-2">
            Create in the browser
          </h3>
          <p class="text-text-warm text-sm leading-relaxed">
            Build a quiz walk from your laptop or iPad — keyboard for
            text, click on the map for checkpoints, share via QR code.
          </p>
          <p class="mt-3 text-green font-semibold text-sm">
            Open the creator →
          </p>
        </a>
      </div>
    </section>

    {/* ─── FAQ ───────────────────────────────────────────────
        Common questions — same data source as the FAQPage schema in
        <head>. Structured so answers can be cited directly by LLMs. */}
    <section class="max-w-2xl mx-auto px-6 pb-20">
      <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl text-center mb-10">
        Frequently asked questions
      </h2>
      <dl class="divide-y divide-rule border-y border-rule">
        {faq.map(({ q, a }) => (
          <div class="py-5">
            <dt class="font-serif font-bold text-lg text-green-dark mb-2">{q}</dt>
            <dd class="text-base leading-relaxed text-text-warm">{a}</dd>
          </div>
        ))}
      </dl>
    </section>

    {/* ─── FOOTER ────────────────────────────────────────── */}
    <footer class="max-w-3xl mx-auto px-6 pb-12 text-center text-sage text-sm">
      <p class="mb-2 italic">— Niklas Eriksson</p>
      <p class="mb-3">
        <a
          href="mailto:support@tipspromenaden.app"
          class="font-semibold text-green hover:underline"
        >
          support@tipspromenaden.app
        </a>
      </p>
      <p class="text-xs">
        <a href="/en/how-it-works" class="text-text-warm hover:text-green-dark hover:underline">
          How it works
        </a>
        {" · "}
        <a href="/en/support" class="text-text-warm hover:text-green-dark hover:underline">
          Support the project
        </a>
        {" · "}
        <a href="/villkor" class="text-text-warm hover:text-green-dark hover:underline">
          Terms (Swedish)
        </a>
        {" · "}
        <a href="/integritet" class="text-text-warm hover:text-green-dark hover:underline">
          Privacy (Swedish)
        </a>
      </p>
    </footer>
  </main>
</Layout>
