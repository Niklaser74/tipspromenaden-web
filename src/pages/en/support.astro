---
import Layout from "../../layouts/Layout.astro";
import SupportersSection from "../../components/SupportersSection.tsx";

const SWISH_NUMBER = "070-520 54 52";
const SWISH_NUMBER_RAW = "46705205452";
const SWISH_AMOUNT = "50";
const SWISH_MESSAGE = "Tipspromenaden -- Bidrag";
const SWISH_LINK = `https://app.swish.nu/1/p/sw/?sw=${SWISH_NUMBER_RAW}&amt=${SWISH_AMOUNT}&cur=SEK&msg=${encodeURIComponent(SWISH_MESSAGE)}`;

const PAYPAL_HANDLE = "niklaser3d";
const PAYPAL_LINK = `https://paypal.me/${PAYPAL_HANDLE}`;

const title = "Support the project — Tipspromenaden";
const description =
  "Tipspromenaden is free and runs as a hobby project. Want to help cover hosting, domain and Apple's developer program? Donate via Swish (Sweden) or PayPal (international).";
---

<Layout title={title} description={description} lang="en" alternateUrl="/stod">
  <main class="min-h-screen">
    <div class="max-w-3xl mx-auto px-6 pt-12">
      <a
        href="/en/"
        class="text-sm text-text-warm hover:text-green-dark inline-block"
      >
        ← Tipspromenaden.app
      </a>
    </div>

    {/* ─── HERO ──────────────────────────────────────────── */}
    <section class="max-w-3xl mx-auto px-6 pt-8 pb-10 text-center">
      <p class="text-sm tracking-[0.25em] text-sage uppercase mb-4">
        Support the project
      </p>
      <hr class="w-12 border-t border-green mx-auto mb-12" />

      <h1 class="font-serif font-bold text-4xl sm:text-5xl md:text-6xl text-green-dark leading-tight mb-6">
        Thanks if you'd like to help
      </h1>
      <p class="font-serif italic text-lg sm:text-xl md:text-2xl text-green">
        Tipspromenaden is free to use — and will stay that way.
      </p>
    </section>

    {/* ─── STORY ─────────────────────────────────────────── */}
    <section class="max-w-2xl mx-auto px-6 pb-12">
      <div class="space-y-5 text-lg leading-relaxed">
        <p>
          The project started when Hofors municipality went through a
          rough financial period and I wanted to do something for the
          schools and after-school clubs — an app teachers could build
          experiences in and reuse in their teaching, outdoors instead
          of in the classroom.
        </p>
        <p>
          It grew bigger and more fun than I expected. Today the app
          is on both Google Play and the App Store and keeps going as
          a hobby project. It's free to use and will stay that way.
        </p>
        <p>
          Running it does cost money though — domain, hosting and
          Apple's developer program add up to a yearly bill I'd rather
          cover via donations than out of my own pocket. That way I
          can focus on improving the app instead of wondering whether
          it's worth keeping alive.
        </p>
      </div>
    </section>

    {/* Hairline */}
    <hr class="w-24 border-t border-rule mx-auto mb-16" />

    {/* ─── COST BREAKDOWN ─────────────────────────────── */}
    <section class="max-w-2xl mx-auto px-6 pb-16">
      <h2 class="font-serif text-2xl sm:text-3xl text-center mb-8">
        Where the money goes
      </h2>
      <div class="bg-white border border-rule rounded-2xl overflow-hidden">
        <div class="flex justify-between px-6 py-4 border-b border-rule">
          <span>Domain + hosting (Cloudflare)</span>
          <span class="font-semibold text-text-warm">~120 SEK/year</span>
        </div>
        <div class="flex justify-between px-6 py-4 border-b border-rule">
          <span>Apple Developer Program</span>
          <span class="font-semibold text-text-warm">~1 100 SEK/year</span>
        </div>
        <div class="flex justify-between px-6 py-4 border-b border-rule">
          <span>Google Play account <span class="text-sm text-sage">(one-time)</span></span>
          <span class="font-semibold text-text-warm">~270 SEK</span>
        </div>
        <div class="flex justify-between px-6 py-4 border-b border-rule">
          <span>Firebase (data, auth, storage)</span>
          <span class="font-semibold text-text-warm">0 SEK (free tier)</span>
        </div>
        <div class="flex justify-between px-6 py-4 bg-cream font-semibold text-green-dark">
          <span>Yearly running cost</span>
          <span>~1 220 SEK/year</span>
        </div>
      </div>
      <p class="text-sm text-sage mt-4 text-center italic">
        Transparent: every donation goes to running costs — no
        development time is invoiced. Any surplus rolls over into next
        year or future paid features (e.g. Cloud Functions for cheat-
        protection on leaderboards).
      </p>
    </section>

    {/* ─── SWISH-CTA ─────────────────────────────────────── */}
    <section class="max-w-3xl mx-auto px-6 pb-20">
      <div class="bg-green-dark text-cream rounded-3xl p-8 sm:p-12 text-center">
        <p class="text-sm tracking-[0.25em] uppercase text-cta-body mb-3">
          Swish (Sweden)
        </p>
        <h2 class="font-serif text-cream text-3xl sm:text-4xl mb-2">
          Donate via Swish
        </h2>
        <p class="text-cta-body text-base mb-8">
          Suggested: <strong class="text-cream">50 SEK</strong> — or any
          amount you choose in the Swish app.
        </p>

        <div class="flex flex-col items-center gap-4 mb-6">
          <a
            href={SWISH_LINK}
            class="bg-cream rounded-2xl p-4 hover:shadow-lg transition relative"
            aria-label="Open payment in the Swish app"
          >
            <img
              src="/swish-qr.svg"
              alt={`Swish QR code for ${SWISH_NUMBER}`}
              width="220"
              height="220"
              class="w-48 h-48 sm:w-56 sm:h-56 block"
            />
            <img
              src="/icon.png"
              alt=""
              aria-hidden="true"
              width="48"
              height="48"
              class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-9 h-9 sm:w-12 sm:h-12 rounded-xl ring-4 ring-cream"
            />
          </a>

          <a
            href={SWISH_LINK}
            class="inline-block bg-cream text-green-dark font-semibold text-base sm:text-lg px-6 py-3 rounded-xl hover:bg-white transition"
          >
            📱 Open in the Swish app
          </a>
        </div>

        <p class="text-cta-body text-sm mb-2">
          Or scan the QR code above — or type the number manually:
        </p>
        <p class="font-mono text-cream text-2xl sm:text-3xl font-semibold tracking-wider mb-2">
          {SWISH_NUMBER}
        </p>
        <p class="text-cta-body text-xs mb-8 opacity-80">
          Message: <em>Tipspromenaden — Bidrag</em>
        </p>

        <div class="w-14 h-1 bg-yellow mx-auto mb-6"></div>

        <p class="text-cta-body text-sm leading-relaxed max-w-md mx-auto">
          Thank you ❤️ — every donation, however small, makes a
          difference and goes a long way on a hobby budget.
        </p>
      </div>
    </section>

    {/* ─── PAYPAL-CTA (international) ─────────────────── */}
    <section class="max-w-3xl mx-auto px-6 pb-12">
      <div class="bg-white border-2 border-green-dark rounded-3xl p-8 sm:p-12 text-center">
        <p class="text-sm tracking-[0.25em] uppercase text-sage mb-3">
          🌍 International
        </p>
        <h2 class="font-serif text-green-dark text-2xl sm:text-3xl mb-2">
          Donate from abroad via PayPal
        </h2>
        <p class="text-text-warm text-base mb-8">
          Swish only works in Sweden — international supporters can use
          PayPal instead. You choose currency and amount.
        </p>

        <div class="flex flex-col items-center gap-4 mb-6">
          <a
            href={PAYPAL_LINK}
            class="bg-cream rounded-2xl p-4 hover:shadow-lg transition relative"
            aria-label="Open the PayPal link"
          >
            <img
              src="/paypal-qr.svg"
              alt={`PayPal QR code for ${PAYPAL_HANDLE}`}
              width="220"
              height="220"
              class="w-48 h-48 sm:w-56 sm:h-56 block"
            />
            <img
              src="/icon.png"
              alt=""
              aria-hidden="true"
              width="48"
              height="48"
              class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-9 h-9 sm:w-12 sm:h-12 rounded-xl ring-4 ring-cream"
            />
          </a>

          <a
            href={PAYPAL_LINK}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block bg-green-dark text-cream font-semibold text-base sm:text-lg px-6 py-3 rounded-xl hover:bg-green transition"
          >
            🌍 Open the PayPal link
          </a>
        </div>

        <p class="text-text-warm text-sm mb-2">
          Or type the address directly:
        </p>
        <p class="font-mono text-green-dark text-lg sm:text-xl font-semibold mb-2 break-all">
          paypal.me/{PAYPAL_HANDLE}
        </p>
        <p class="text-sage text-xs opacity-80">
          No PayPal account needed — guest checkout with a card works.
        </p>
      </div>
    </section>

    {/* ─── SUPPORTERS ─────────────────────────────────────
        Name list from the config/supporters Firestore doc (same as
        the app's thank-you screen). Edited via /admin → 💚 Supportrar.
        Renders nothing at all if the list is empty. */}
    <SupportersSection client:idle lang="en" />

    {/* ─── FALLBACK ───────────────────────────────────── */}
    <section class="max-w-2xl mx-auto px-6 pb-20 text-center">
      <p class="text-sm text-sage italic">
        Prefer another method? Drop a line at{" "}
        <a
          href="mailto:support@tipspromenaden.app"
          class="text-green font-semibold hover:underline"
        >
          support@tipspromenaden.app
        </a>
        {" "}and we'll figure something out.
      </p>
    </section>
  </main>
</Layout>
