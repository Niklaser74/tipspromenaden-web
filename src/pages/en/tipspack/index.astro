---
import Layout from "../../../layouts/Layout.astro";
import { Flag } from "../../../components/Flag.tsx";
import UserTipspacks from "../../../components/tipspack/UserTipspacks.tsx";
import { getCuratedTipspacks } from "../../../lib/curatedTipspacks";

// /en/tipspack — English version of the curated question-pack library.
// Same .tipspack files (statiska assets i public/tipspack/), bara
// engelsk UI runt om.

const packs = getCuratedTipspacks().map((p) => ({
  ...p,
  url: `/tipspack/${p.filename}`,
  fileSizeKb: Math.round(p.fileSizeBytes / 1024),
}));
---

<Layout
  title="Ready-made question packs — Tipspromenaden"
  description="Download ready-made question packs (.tipspack files) for free and import them into the Tipspromenaden app or web creator. Stockholm Old Town, Visby, pop culture, science and more."
  lang="en"
  alternateUrl="/tipspack"
>
  <main class="min-h-screen bg-cream">
    <div class="max-w-4xl mx-auto px-6 py-12">
      <header class="mb-12">
        <a
          href="/en/"
          class="text-sm text-text-warm hover:text-green-dark mb-6 inline-block"
        >
          ← Tipspromenaden.app
        </a>
        <h1 class="font-serif text-4xl md:text-5xl text-green-dark mb-4">
          Ready-made question packs
        </h1>
        <p class="text-lg text-text-warm leading-relaxed max-w-2xl">
          Free question collections you can download and use when
          building your own quiz walk. Anything from city tours to
          nature quizzes for kids.
        </p>
        <p class="text-sm text-sage italic mt-3 max-w-2xl">
          Heads up: most curated packs are in Swedish — the language
          flag on each pack tells you which.
        </p>
      </header>

      <section class="mb-10 bg-white border border-rule rounded-xl p-5">
        <h2 class="font-serif text-xl text-green-dark mb-3">
          How to use the files
        </h2>
        <p class="text-sm text-text-warm leading-relaxed mb-3">
          <strong>Fastest (Tipspromenaden 1.4.0+):</strong> Tap{" "}
          <strong>📲 Open in app</strong>. Your phone asks if you want to
          open the app — pick Tipspromenaden, and you jump straight into
          map mode with all questions preloaded. Place them one by one,
          ready to go.
        </p>
        <p class="text-sm text-text-warm leading-relaxed">
          <strong>Alternative:</strong> Tap <strong>📥 Download file</strong>{" "}
          to save the <code class="bg-cream px-1 rounded">.tipspack</code> file
          locally. Then import it via <strong>Import question pack</strong>{" "}
          in the mobile app or the{" "}
          <a href="/skapa" class="text-green font-semibold hover:underline">
            web creator
          </a>
          . Use this if you want to archive the file, edit it manually,
          or pass it along.
        </p>
      </section>

      {packs.length === 0 ? (
        <p class="text-center text-text-warm py-12">
          No question packs published yet.
        </p>
      ) : (
        <ul class="space-y-4">
          {packs.map((p) => (
            <li class="bg-white border border-rule rounded-xl p-5 hover:border-green-dark transition">
              <div class="flex items-start justify-between gap-4 flex-wrap">
                <div class="flex-1 min-w-0">
                  <h2 class="font-serif text-2xl text-green-dark mb-1 flex items-center gap-2">
                    <Flag code={p.language} height={22} />
                    <span>{p.name}</span>
                  </h2>
                  <p class="text-sm text-text-warm leading-relaxed mb-3">
                    {p.description}
                  </p>
                  <p class="text-xs text-sage">
                    {p.questionCount} questions · {p.author} · {p.fileSizeKb} KB
                  </p>
                </div>
                <div class="flex flex-col gap-2 shrink-0">
                  <a
                    href={`tipspromenaden://tipspack/${p.slug}`}
                    class="bg-green-dark text-cream px-5 py-2 rounded-full text-sm font-semibold shadow hover:shadow-md transition text-center"
                    title="Open directly in the Tipspromenaden app (requires the app installed, v1.4.0+)"
                  >
                    📲 Open in app
                  </a>
                  <a
                    href={p.url}
                    download={p.filename}
                    class="border border-green-dark text-green-dark px-5 py-2 rounded-full text-sm font-semibold hover:bg-green-dark/5 transition text-center"
                  >
                    📥 Download file
                  </a>
                  <button
                    data-copy-url={`https://tipspromenaden.app${p.url}`}
                    class="copy-btn text-text-warm text-xs hover:text-green-dark"
                  >
                    Copy link
                  </button>
                </div>
              </div>
              <div class="mt-3">
                <button
                  data-preview-url={p.url}
                  data-preview-slug={p.slug}
                  class="preview-btn text-xs text-green-dark hover:underline"
                >
                  Preview questions
                </button>
                <div
                  class="preview-target hidden mt-2 bg-cream/50 border border-rule rounded-lg p-3"
                  data-preview-for={p.slug}
                >
                  <p class="text-sm text-text-warm">Loading questions…</p>
                </div>
              </div>
            </li>
          ))}
        </ul>
      )}

      <section class="mt-16">
        <h2 class="font-serif text-3xl text-green-dark mb-3">
          User-uploaded packs
        </h2>
        <p class="text-sm text-text-warm mb-6 leading-relaxed">
          Question packs other Tipspromenaden users uploaded and shared
          publicly. Want to add one yourself?{" "}
          <a
            href="/skapa"
            class="text-green font-semibold hover:underline"
          >
            Sign in at /skapa
          </a>{" "}
          and tap "Upload" under "My tipspacks". (The creator interface
          is currently Swedish-only.)
        </p>
        <UserTipspacks client:idle />
      </section>
    </div>
  </main>

  <script is:inline>
    /* Block comments only — Astro collapses newlines in inline scripts,
       so //-comments would eat the rest of the script. */
    document.querySelectorAll(".copy-btn").forEach(function (btn) {
      btn.addEventListener("click", async function () {
        const url = btn.dataset.copyUrl;
        if (!url) return;
        try {
          await navigator.clipboard.writeText(url);
          const original = btn.textContent;
          btn.textContent = "Copied!";
          setTimeout(function () { btn.textContent = original; }, 2000);
        } catch (e) { /* silent */ }
      });
    });

    const __loadedTipspacks = new Set();
    document.querySelectorAll(".preview-btn").forEach(function (btn) {
      btn.addEventListener("click", async function () {
        const url = btn.dataset.previewUrl;
        const slug = btn.dataset.previewSlug;
        if (!url || !slug) return;
        const target = document.querySelector('[data-preview-for="' + slug + '"]');
        if (!target) return;
        if (!target.classList.contains("hidden")) {
          target.classList.add("hidden");
          btn.textContent = "Preview questions";
          return;
        }
        target.classList.remove("hidden");
        btn.textContent = "Hide questions";
        if (__loadedTipspacks.has(slug)) return;
        try {
          const res = await fetch(url);
          if (!res.ok) throw new Error("HTTP " + res.status);
          const data = await res.json();
          const questions = data.questions || [];
          const list = questions.map(function (q, i) {
            return "<li>" + (i + 1) + ". " + __escapeHtml(q.text) + "</li>";
          }).join("");
          target.innerHTML =
            '<p class="text-xs text-text-warm mb-2 italic">Questions are shown without answers so the game isn\'t spoiled.</p>' +
            '<ol class="space-y-1 text-sm text-green-dark">' + list + '</ol>';
          __loadedTipspacks.add(slug);
        } catch (e) {
          target.innerHTML = '<p class="text-sm text-red-700">Couldn\'t load the questions.</p>';
        }
      });
    });

    function __escapeHtml(s) {
      return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#39;");
    }
  </script>
</Layout>
