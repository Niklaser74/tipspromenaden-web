---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import UpcomingEventsTeaser from "../components/UpcomingEventsTeaser.tsx";
import appIcon from "../assets/icon.png";
import skarmHem from "../assets/screenshots/skarm-hem.jpg";
import skarmGaMed from "../assets/screenshots/skarm-ga-med.jpg";
import skarmAktiv from "../assets/screenshots/skarm-aktiv.jpg";

// Appen är live på BÅDA store-plattformar (Android sedan 2026-05-17,
// iOS sedan 2026-05-24). CTA visar bägge knappar sida-vid-sida.
const PLAY_STORE_URL =
  "https://play.google.com/store/apps/details?id=com.tipspromenaden.app";
const APP_STORE_URL = "https://apps.apple.com/se/app/id6770503457";

// FAQ — vanliga frågor som besvaras strukturerat. Samma datakälla
// driver både den synliga sektionen längst ner och FAQPage-schemat i
// <head>, så att svaren kan extraheras direkt av LLM:er och Google
// (GEO/AEO). Håll svaren korta och faktiska — ett svar per fråga.
const faq = [
  {
    q: "Krävs internet?",
    a: "Du behöver internet för att ladda ner promenaden första gången. Sedan fungerar den offline om du tappar täckning ute — GPS:en låser upp frågorna lokalt.",
  },
  {
    q: "Hur många deltagare kan vara med?",
    a: "Obegränsat. Alla som har länken eller skannar QR-koden kan gå samtidigt och syns i samma topplista i realtid.",
  },
  {
    q: "Vad kostar appen?",
    a: "Inget. Tipspromenaden är helt gratis utan reklam och utan köp i appen — den drivs som ett hobbyprojekt.",
  },
  {
    q: "Måste jag logga in för att delta?",
    a: "Nej. Som deltagare anger du bara ett namn. Inloggning med Google krävs bara om du vill skapa egna promenader.",
  },
  {
    q: "Vilka enheter och plattformar stöds?",
    a: "Appen finns för både iPhone (iOS) och Android. Du kan dessutom skapa promenader i webbläsaren på dator eller iPad via /skapa.",
  },
  {
    q: "Hur delar jag en promenad med andra?",
    a: "När du sparat en promenad får du automatiskt en QR-kod och en länk. Skriv ut QR-koden eller dela länken — deltagarna behöver inget konto.",
  },
  {
    q: "Vilka språk finns appen på?",
    a: "Svenska, engelska, tyska, norska, danska, finska, franska och spanska. Appen kan följa systemspråket eller ställas in manuellt.",
  },
];

// FAQPage-schema byggt från samma faq-array — skickas till Layout som
// renderar det som ett JSON-LD-block i <head>.
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
};

const screenshots = [
  {
    src: skarmHem,
    alt: "Hemskärm med rubriken Tipspromenaden, Skapa promenad-knapp och en lista över egna sparade promenader",
    caption: "Din egen samling av promenader",
  },
  {
    src: skarmGaMed,
    alt: "Gå med-skärm där en deltagare skriver in sitt namn för att starta en pågående promenad",
    caption: "Skriv namn — anslut till en pågående omgång",
  },
  {
    src: skarmAktiv,
    alt: "Karta som visar 13 numrerade kontrollpunkter och avståndet till nästa kontroll",
    caption: "GPS visar var nästa kontroll finns",
  },
];
---

<Layout lang="sv" alternateUrl="/en/" jsonLd={[faqJsonLd]}>
  <main class="min-h-screen">
    {/* ─── HERO ──────────────────────────────────────────── */}
    <section class="max-w-3xl mx-auto px-6 pt-20 pb-12 text-center">
      <p class="text-sm tracking-[0.25em] text-sage uppercase mb-4">
        Quizpromenad i fickan
      </p>
      <hr class="w-12 border-t border-green mx-auto mb-12" />

      {/* Optimerad app-ikon — Astro genererar små webp-varianter
          (128/256px) istället för att skicka original-PNG:n på 1024px.
          fetchpriority=high + eager-laddning eftersom ikonen ligger
          ovanför vikningen och ofta är LCP-elementet på mobil. */}
      <Image
        src={appIcon}
        alt="Tipspromenaden-appens ikon"
        width={128}
        height={128}
        densities={[1, 2]}
        loading="eager"
        fetchpriority="high"
        class="w-28 h-28 mx-auto rounded-3xl mb-10 shadow-sm"
      />

      <h1 class="font-serif font-bold text-4xl sm:text-6xl md:text-7xl text-green-dark leading-none mb-6">
        Tipspromenaden
      </h1>
      <p class="font-serif italic text-lg sm:text-xl md:text-2xl text-green">
        En quiz­promenad ni går utomhus — med mobilen som frågepapper.
      </p>
    </section>

    {/* ─── KOMMANDE EVENT ────────────────────────────────────
        Realtid-fetch från Firestore via React-island. Visas bara om
        det finns publika walks med event-datum inom 30 dagar. Hela
        sektionen försvinner annars — vi vill aldrig ha tom yta. */}
    <UpcomingEventsTeaser client:idle lang="sv" />

    {/* (Tidigare här: iPhone-banner "Stöd projektet så släpper vi
        iOS-versionen" — borttagen 2026-05-24 när iOS-launchen var
        klar. CTA-sektionen längre ner visar nu båda store-knappar.) */}

    {/* ─── INTRO ─────────────────────────────────────────── */}
    <section class="max-w-2xl mx-auto px-6 pb-16 text-center">
      <p class="text-lg leading-relaxed">
        Skaparen ritar kontroll­punkter på en karta och kopplar en fråga till
        varje punkt. Deltagarna skannar QR-koden och går till varje punkt med
        GPS — frågan låses upp automatiskt när de kommer fram. Familje­turen
        blir plötsligt en lagom-tävling.
      </p>
    </section>

    {/* Hairline — andas innan tre features */}
    <hr class="w-24 border-t border-rule mx-auto mb-20" />

    {/* ─── FEATURES ──────────────────────────────────────── */}
    <section class="max-w-5xl mx-auto px-6 pb-20 grid md:grid-cols-3 gap-12">
      {[
        {
          title: "Bygg själv",
          body: "Karta, frågor, bilder, QR-kod — på minuter. Eller importera ett färdigt frågebatteri."
        },
        {
          title: "GPS låser frågorna",
          body: "Ingen kan hoppa över kontroller. Tävlings­känsla utan stress, fusk-skydd utan fri­ktion."
        },
        {
          title: "Topplista i realtid",
          body: "Hela familjen tävlar samtidigt och alla ser ställningen. Snittsteg, snittpoäng och svars­fördelning för skaparen."
        }
      ].map(({ title, body }) => (
        <div class="text-center md:text-left">
          {/* Diamantmarkör i Friluft Folio-anda */}
          <div class="inline-block w-3 h-3 bg-green rotate-45 mb-4"></div>
          <h3 class="font-serif font-bold text-2xl mb-3">{title}</h3>
          <p class="text-base leading-relaxed">{body}</p>
        </div>
      ))}
    </section>

    {/* ─── SKÄRMDUMPAR ───────────────────────────────────── */}
    {/* Visuellt bevis innan CTA — "så här ser det faktiskt ut".
        Mobil: horisontell snap-scroll så fingret kan svepa mellan dem
        utan att hela sidan blir orimligt lång.
        Desktop: 3-up grid, lugnt och paralllelt likt Friluft Folio-rytmen. */}
    <section class="max-w-6xl mx-auto pb-24">
      <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl text-center mb-12 px-6">
        Så ser det ut
      </h2>

      <div
        class="flex md:grid md:grid-cols-3 gap-6 md:gap-12 overflow-x-auto md:overflow-visible snap-x snap-mandatory scroll-smooth px-6 md:px-6 pb-6 md:pb-0 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      >
        {screenshots.map(({ src, alt, caption }) => (
          <figure class="snap-center shrink-0 w-[260px] md:w-auto mx-auto text-center">
            <div class="bg-white rounded-2xl ring-1 ring-rule shadow-lg shadow-green-dark/15 overflow-hidden">
              <Image
                src={src}
                alt={alt}
                widths={[260, 320, 480, 640]}
                sizes="(min-width: 768px) 320px, 260px"
                class="w-full h-auto block"
                loading="lazy"
              />
            </div>
            <figcaption class="mt-4 text-sm font-serif italic text-sage">
              {caption}
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    {/* ─── SÅ SKAPAR DU DIN FÖRSTA PROMENAD ───────────────────
        Fördjupande innehåll om användarresan — ger AI-modeller och
        nya användare konkret kontext om hur appen faktiskt används,
        steg för steg. Ordnad lista så stegen kan extraheras direkt. */}
    <section class="max-w-2xl mx-auto px-6 pb-20">
      <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl text-center mb-4">
        Så här skapar du din första tipspromenad
      </h2>
      <p class="text-base leading-relaxed text-center text-text-warm mb-10 max-w-xl mx-auto">
        Från tom karta till färdig QR-kod tar några minuter. Du kan bygga
        i appen ute på plats eller vid datorn på <a href="/skapa" class="text-green underline">tipspromenaden.app/skapa</a>.
      </p>
      <ol class="space-y-6">
        {[
          {
            title: "Skapa en promenad och välj plats",
            body: "Tryck på Skapa promenad och logga in med Google. Zooma kartan till parken, skolgården eller stadsdelen där promenaden ska gå.",
          },
          {
            title: "Placera kontrollpunkter på kartan",
            body: "Tryck där varje kontroll ska ligga — appen numrerar dem automatiskt. En typisk familjepromenad har 8–13 kontroller på 1–3 km.",
          },
          {
            title: "Skriv frågor och svarsalternativ",
            body: "Koppla en fråga till varje kontroll, lägg till svarsalternativ och markera det rätta. Du kan ladda upp en bild per fråga, eller importera ett färdigt frågebatteri från biblioteket.",
          },
          {
            title: "Välj aktivitetstyp och eventläge",
            body: "Promenad (15 m GPS-trigger) eller cykel (50 m med förvarning). Sätt start- och slutdatum om alla ska tävla i samma omgång med gemensam topplista.",
          },
          {
            title: "Dela QR-koden",
            body: "Spara så får du en QR-kod och en länk. Skriv ut koden vid startpunkten eller dela länken — deltagarna behöver varken konto eller inloggning för att gå.",
          },
        ].map(({ title, body }, i) => (
          <li class="flex gap-4">
            <span class="shrink-0 w-9 h-9 rounded-full bg-green-dark text-cream font-serif font-bold flex items-center justify-center">
              {i + 1}
            </span>
            <div>
              <h3 class="font-serif font-bold text-xl mb-1">{title}</h3>
              <p class="text-base leading-relaxed text-text-warm">{body}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="text-sm text-sage italic text-center mt-10">
        Vill du ha hela steg-för-steg-guiden för både skapare och
        deltagare? Läs <a href="/sa-funkar-det" class="text-green underline not-italic">Så funkar det</a>.
      </p>
    </section>

    {/* ─── ANVÄNDNINGSOMRÅDEN ─────────────────────────────────
        Konkreta scenarier — hjälper både besökare och AI förstå vad
        appen används till. Punktlista optimerad för extraktion. */}
    <section class="max-w-3xl mx-auto px-6 pb-20">
      <h2 class="font-serif text-2xl sm:text-3xl text-center mb-8">
        Perfekt för
      </h2>
      <ul class="grid sm:grid-cols-2 gap-x-10 gap-y-4 max-w-2xl mx-auto list-disc pl-5 marker:text-green">
        <li class="text-base leading-relaxed"><strong>Skola och fritids</strong> — lärorika utomhusövningar där frågorna kopplas till naturen eller orten.</li>
        <li class="text-base leading-relaxed"><strong>Familjefester och kalas</strong> — en lagom tävling som får alla åldrar att röra på sig.</li>
        <li class="text-base leading-relaxed"><strong>Möhippor och svensexor</strong> — bygg en rolig runda med personliga frågor om paret.</li>
        <li class="text-base leading-relaxed"><strong>Företagskickoff och teambuilding</strong> — lag tävlar mot varandra med live-topplista.</li>
        <li class="text-base leading-relaxed"><strong>Föreningar och evenemang</strong> — publicera promenaden så alla i området kan delta.</li>
        <li class="text-base leading-relaxed"><strong>Turistrundor</strong> — guida besökare mellan sevärdheter med frågor om platsen.</li>
      </ul>
    </section>

    {/* ─── CTA ───────────────────────────────────────────── */}
    <section class="max-w-3xl mx-auto px-6 pb-20">
      <div class="bg-green-dark text-cream rounded-3xl p-10 md:p-14 text-center">
        <p class="text-sm tracking-[0.25em] uppercase text-cta-body mb-3">
          Gratis på App Store och Google Play
        </p>
        <h2 class="font-serif text-cream text-3xl sm:text-4xl md:text-5xl mb-6">
          Ladda ner och kom igång
        </h2>
        <p class="text-cta-body text-lg mb-10 max-w-xl mx-auto leading-relaxed">
          Tipspromenaden finns för både iPhone och Android — helt gratis.
          Skapa en egen tipspromenad eller scanna en QR-kod och börja gå
          direkt.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center items-center max-w-xl mx-auto">
          <a
            href={APP_STORE_URL}
            class="inline-block bg-cream text-green-dark font-semibold text-lg px-8 py-4 rounded-xl hover:bg-white transition-colors w-full sm:w-auto"
          >
            🍏 Hämta på App Store
          </a>
          <a
            href={PLAY_STORE_URL}
            class="inline-block bg-cream text-green-dark font-semibold text-lg px-8 py-4 rounded-xl hover:bg-white transition-colors w-full sm:w-auto"
          >
            🤖 Hämta på Google Play
          </a>
        </div>
        <p class="text-cta-body text-sm mt-6 max-w-md mx-auto leading-relaxed opacity-80">
          Vill du stötta projektet hittar du bidragsalternativ under{" "}
          <a href="/stod" class="underline">Stöd oss</a>.
        </p>
        {/* Gul accent under knappen — den ena varmgula glimt som palettens
            restraint tillåter, samma plats som CTA-blocket på social-postern */}
        <div class="w-14 h-1 bg-yellow mx-auto mt-8"></div>
      </div>
    </section>

    {/* ─── Sekundära länkar — tipspack + skapa ────────────── */}
    <section class="max-w-3xl mx-auto px-6 pb-16">
      <div class="grid md:grid-cols-2 gap-4">
        <a
          href="/tipspack"
          class="block bg-white border border-rule rounded-2xl p-6 hover:border-green-dark transition"
        >
          <h3 class="font-serif text-2xl text-green-dark mb-2">
            Färdiga frågebatterier
          </h3>
          <p class="text-text-warm text-sm leading-relaxed">
            Ladda ner gratis frågesamlingar — Stockholms gamla stan, Visby,
            populärkultur, naturvetenskap och fler. Importera direkt i appen.
          </p>
          <p class="mt-3 text-green font-semibold text-sm">
            Bläddra biblioteket →
          </p>
        </a>
        <a
          href="/skapa"
          class="block bg-white border border-rule rounded-2xl p-6 hover:border-green-dark transition"
        >
          <h3 class="font-serif text-2xl text-green-dark mb-2">
            Skapa i webbläsaren
          </h3>
          <p class="text-text-warm text-sm leading-relaxed">
            Bygg en tipspromenad från laptop eller iPad — tangentbord för
            text, klick på kartan för kontroller, dela med en QR-kod.
          </p>
          <p class="mt-3 text-green font-semibold text-sm">
            Öppna skaparen →
          </p>
        </a>
      </div>
    </section>

    {/* ─── FAQ ───────────────────────────────────────────────
        Vanliga frågor — samma datakälla som FAQPage-schemat i <head>.
        Strukturerat så svaren kan citeras direkt av LLM:er (GEO). */}
    <section class="max-w-2xl mx-auto px-6 pb-20">
      <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl text-center mb-10">
        Vanliga frågor
      </h2>
      <dl class="divide-y divide-rule border-y border-rule">
        {faq.map(({ q, a }) => (
          <div class="py-5">
            <dt class="font-serif font-bold text-lg text-green-dark mb-2">{q}</dt>
            <dd class="text-base leading-relaxed text-text-warm">{a}</dd>
          </div>
        ))}
      </dl>
    </section>

    {/* ─── FOOTER ────────────────────────────────────────── */}
    <footer class="max-w-3xl mx-auto px-6 pb-12 text-center text-sage text-sm">
      <p class="mb-2 italic">— Niklas Eriksson</p>
      <p class="mb-3">
        <a
          href="mailto:support@tipspromenaden.app"
          class="font-semibold text-green hover:underline"
        >
          support@tipspromenaden.app
        </a>
      </p>
      <p class="text-xs">
        <a href="/sa-funkar-det" title="Steg-för-steg-guide över hur appen fungerar — för skapare och deltagare." class="text-text-warm hover:text-green-dark hover:underline">
          Så funkar det
        </a>
        {" · "}
        <a href="/stod" title="Kontaktinformation, vanliga frågor och sätt att stödja projektet." class="text-text-warm hover:text-green-dark hover:underline">
          Stötta projektet
        </a>
        {" · "}
        <a href="/villkor" title="Användarvillkor — vad som gäller när du skapar eller spelar en tipspromenad." class="text-text-warm hover:text-green-dark hover:underline">
          Användarvillkor
        </a>
        {" · "}
        <a href="/integritet" title="Integritetspolicy — vilken data vi samlar in, hur länge vi sparar den, och dina GDPR-rättigheter." class="text-text-warm hover:text-green-dark hover:underline">
          Integritetspolicy
        </a>
      </p>
    </footer>
  </main>
</Layout>
