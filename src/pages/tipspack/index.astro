---
import Layout from "../../layouts/Layout.astro";
import { Flag } from "../../components/Flag.tsx";
import UserTipspacks from "../../components/tipspack/UserTipspacks.tsx";
import { getCuratedTipspacks } from "../../lib/curatedTipspacks";

// /tipspack — publik bibliotekssida för färdiga frågebatterier.
// Filerna ligger som statiska assets i `public/tipspack/`. Metadata
// läses vid build-tid via getCuratedTipspacks (delas med /tipspack/index.json).

const packs = getCuratedTipspacks().map((p) => ({
  ...p,
  url: `/tipspack/${p.filename}`,
  fileSizeKb: Math.round(p.fileSizeBytes / 1024),
}));
---

<Layout
  title="Färdiga frågebatterier — Tipspromenaden"
  description="Ladda ner färdiga frågebatterier (.tipspack-filer) gratis och importera dem i Tipspromenaden-appen eller webb-skaparen. Stockholms gamla stan, Visby, populärkultur, naturvetenskap med mera."
>
  <main class="min-h-screen bg-cream">
    <div class="max-w-4xl mx-auto px-6 py-12">
      <header class="mb-12">
        <a
          href="/"
          class="text-sm text-text-warm hover:text-green-dark mb-6 inline-block"
        >
          ← Tipspromenaden.app
        </a>
        <h1 class="font-serif text-4xl md:text-5xl text-green-dark mb-4">
          Färdiga frågebatterier
        </h1>
        <p class="text-lg text-text-warm leading-relaxed max-w-2xl">
          Klara frågesamlingar du kan ladda ner gratis och använda när du
          skapar en egen tipspromenad. Allt från stadsvandringar till
          naturquiz för barn.
        </p>
      </header>

      <section class="mb-10 bg-white border border-rule rounded-xl p-5">
        <h2 class="font-serif text-xl text-green-dark mb-3">
          Så här använder du filerna
        </h2>
        <p class="text-sm text-text-warm leading-relaxed mb-3">
          <strong>Snabbast (Tipspromenaden 1.4.0+):</strong> Klicka{" "}
          <strong>📲 Öppna i appen</strong>. Telefonen frågar om du vill öppna
          appen — välj Tipspromenaden, så hoppar du rakt in i karta-läget med
          alla frågor förladdade. Placera dem en och en, klart att gå.
        </p>
        <p class="text-sm text-text-warm leading-relaxed">
          <strong>Alternativ:</strong> Klicka <strong>📥 Ladda ner fil</strong>{" "}
          för att spara <code class="bg-cream px-1 rounded">.tipspack</code>-filen
          lokalt. Importera den sen via <strong>Importera frågebatteri</strong>{" "}
          i mobil-appen eller{" "}
          <a href="/skapa" class="text-green font-semibold hover:underline">
            webb-skaparen
          </a>
          . Använd det här om du vill arkivera filen, redigera den manuellt eller
          dela den vidare.
        </p>
      </section>

      {packs.length === 0 ? (
        <p class="text-center text-text-warm py-12">
          Inga frågebatterier publicerade än.
        </p>
      ) : (
        <ul class="space-y-4">
          {packs.map((p) => (
            <li class="bg-white border border-rule rounded-xl p-5 hover:border-green-dark transition">
              <div class="flex items-start justify-between gap-4 flex-wrap">
                <div class="flex-1 min-w-0">
                  <h2 class="font-serif text-2xl text-green-dark mb-1 flex items-center gap-2">
                    <Flag code={p.language} height={22} />
                    <span>{p.name}</span>
                  </h2>
                  <p class="text-sm text-text-warm leading-relaxed mb-3">
                    {p.description}
                  </p>
                  <p class="text-xs text-sage">
                    {p.questionCount} frågor · {p.author} · {p.fileSizeKb} KB
                  </p>
                </div>
                <div class="flex flex-col gap-2 shrink-0">
                  <a
                    href={`tipspromenaden://tipspack/${p.slug}`}
                    class="bg-green-dark text-cream px-5 py-2 rounded-full text-sm font-semibold shadow hover:shadow-md transition text-center"
                    title="Öppna direkt i Tipspromenaden-appen (kräver appen installerad, v1.4.0+)"
                  >
                    📲 Öppna i appen
                  </a>
                  <a
                    href={p.url}
                    download={p.filename}
                    class="border border-green-dark text-green-dark px-5 py-2 rounded-full text-sm font-semibold hover:bg-green-dark/5 transition text-center"
                  >
                    📥 Ladda ner fil
                  </a>
                  <button
                    data-copy-url={`https://tipspromenaden.app${p.url}`}
                    class="copy-btn text-text-warm text-xs hover:text-green-dark"
                  >
                    Kopiera länk
                  </button>
                </div>
              </div>
              <div class="mt-3">
                <button
                  data-preview-url={p.url}
                  data-preview-slug={p.slug}
                  class="preview-btn text-xs text-green-dark hover:underline"
                >
                  Förhandsgranska frågor
                </button>
                <div
                  class="preview-target hidden mt-2 bg-cream/50 border border-rule rounded-lg p-3"
                  data-preview-for={p.slug}
                >
                  <p class="text-sm text-text-warm">Hämtar frågor…</p>
                </div>
              </div>
            </li>
          ))}
        </ul>
      )}

      {/* Inskickade paket från användare — laddas client-side från Firestore */}
      <section class="mt-16">
        <h2 class="font-serif text-3xl text-green-dark mb-3">
          Inskickade av användare
        </h2>
        <p class="text-sm text-text-warm mb-6 leading-relaxed">
          Frågebatterier som andra Tipspromenaden-användare laddat upp och
          delar publikt. Vill du själv lägga till ett pack?{" "}
          <a
            href="/skapa"
            class="text-green font-semibold hover:underline"
          >
            Logga in på /skapa
          </a>{" "}
          och tryck "Ladda upp" under "Mina tipspacks".
        </p>
        <UserTipspacks client:idle />
      </section>
    </div>
  </main>

  <script>
    // Kopiera-länk-knappar — vanlig clipboard.writeText med tillfällig
    // bekräftelse-text.
    document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const url = btn.dataset.copyUrl;
        if (!url) return;
        try {
          await navigator.clipboard.writeText(url);
          const original = btn.textContent;
          btn.textContent = "Kopierad!";
          setTimeout(() => {
            btn.textContent = original;
          }, 2000);
        } catch {
          // ignored — fallback inte kritiskt
        }
      });
    });

    // Förhandsgranskning av curated-paketens frågor (utan svar). Lazy-fetch
    // när knappen klickas första gången, sedan toggle av synlighet.
    const loaded = new Set<string>();
    document
      .querySelectorAll<HTMLButtonElement>(".preview-btn")
      .forEach((btn) => {
        btn.addEventListener("click", async () => {
          const url = btn.dataset.previewUrl;
          const slug = btn.dataset.previewSlug;
          if (!url || !slug) return;
          const target = document.querySelector<HTMLDivElement>(
            `[data-preview-for="${slug}"]`
          );
          if (!target) return;

          const isHidden = target.classList.contains("hidden");
          if (!isHidden) {
            target.classList.add("hidden");
            btn.textContent = "Förhandsgranska frågor";
            return;
          }
          target.classList.remove("hidden");
          btn.textContent = "Dölj frågor";

          if (loaded.has(slug)) return;
          try {
            const res = await fetch(url);
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            const data = await res.json();
            const questions: { text: string }[] = data.questions ?? [];
            const list = questions
              .map(
                (q, i) =>
                  `<li>${i + 1}. ${escapeHtml(q.text)}</li>`
              )
              .join("");
            target.innerHTML = `
              <p class="text-xs text-text-warm mb-2 italic">
                Frågor visas utan svar för att inte spoila spelet.
              </p>
              <ol class="space-y-1 text-sm text-green-dark">${list}</ol>
            `;
            loaded.add(slug);
          } catch {
            target.innerHTML =
              '<p class="text-sm text-red-700">Kunde inte ladda frågorna.</p>';
          }
        });
      });

    // Minimal HTML-escape så frågetext inte injicerar markup.
    function escapeHtml(s: string): string {
      return s
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }
  </script>
</Layout>
