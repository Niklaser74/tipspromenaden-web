---
import Layout from "../layouts/Layout.astro";

// Statisk catch-all för /walk/<id>-länkar.
//
// Cloudflare _redirects rewrite:ar /walk/* → /walk-redirect.html med
// HTTP 200, så Messenger/iMessage/Slack/Discord får giltigt 200-svar
// med OG-tags och kan visa länkförhandsvisning. Utan den här sidan
// returnerade /walk/<id> 404 (med fallback till 404.astro), och 404
// gör att de flesta sociala plattformar refusar att visa preview.
//
// Sidan extraherar walkId client-side från window.location.pathname
// och försöker:
//  1. Android: deep-link tipspromenaden://walk/<id> (custom scheme).
//     Om appen finns öppnas den; annars fallback till Play Store
//     efter 1.5s.
//  2. iOS: deep-link tipspromenaden://walk/<id>, fallback till App Store.
//  3. Desktop: visar en QR-kod av samma länk så att användaren kan
//     skanna den med telefonen och starta promenaden i appen.

const title = "Öppnar promenad… — Tipspromenaden";
const description =
  "Du har blivit inbjuden till en tipspromenad. Skanna QR-koden med telefonen eller öppna länken på en mobil med Tipspromenaden installerad.";
---

<Layout title={title} description={description}>
  <main class="min-h-screen flex flex-col items-center justify-center px-6 py-12 text-center">
    <img
      src="/icon.png"
      alt=""
      width="96"
      height="96"
      class="w-24 h-24 rounded-2xl mb-8"
    />

    <h1 class="font-serif text-4xl md:text-5xl text-green-dark mb-4">
      Öppnar promenaden…
    </h1>

    <p id="status" class="text-lg max-w-md mb-4 leading-relaxed">
      Om appen inte öppnas automatiskt skickas du vidare om en stund.
    </p>

    <p id="status-en" class="text-base max-w-md mb-10 leading-relaxed text-text-warm italic">
      If the app doesn't open automatically you'll be redirected
      shortly.
    </p>

    <!-- QR-blocket visas bara på desktop. Stylas centrerat med tydlig
         vit ruta runt själva koden så den läses pålitligt av alla
         telefon-kameror även mot beige bakgrund. -->
    <div id="qr-wrap" class="hidden flex-col items-center gap-4 mb-10">
      <div class="bg-white p-4 rounded-2xl shadow-lg">
        <img
          id="qr-img"
          alt="QR-kod till denna promenad"
          width="280"
          height="280"
          class="block w-[280px] h-[280px]"
        />
      </div>
      <p class="text-sm text-text-warm max-w-xs leading-relaxed">
        Skanna med mobilkameran för att starta promenaden i Tipspromenaden-appen.
      </p>
      <p class="text-xs text-text-warm/80 italic max-w-xs leading-relaxed">
        Scan with your phone's camera to start the walk in the Tipspromenaden app.
      </p>
      <div class="flex gap-3 mt-2">
        <a
          id="store-android"
          href="https://play.google.com/store/apps/details?id=com.tipspromenaden.app"
          class="text-sm text-green font-semibold hover:underline"
          target="_blank"
          rel="noopener noreferrer"
        >Google Play</a>
        <span class="text-text-warm/60">·</span>
        <a
          id="store-ios"
          href="https://apps.apple.com/se/app/id6770503457"
          class="text-sm text-green font-semibold hover:underline"
          target="_blank"
          rel="noopener noreferrer"
        >App Store</a>
      </div>
    </div>

    <a href="/" class="text-green font-semibold hover:underline">
      ← Tipspromenaden.app
    </a>
  </main>

  <script>
    import QRCode from "qrcode";

    const PLAY_STORE =
      "https://play.google.com/store/apps/details?id=com.tipspromenaden.app";
    // App Store-länken hålls i synk med App Store-listingens id.
    const APP_STORE =
      "https://apps.apple.com/se/app/id6770503457";

    // Extrahera walkId ur path:en. Format: /walk/<walkId>[/...]
    // Strikt regex som matchar 404.astro — walkId är 96-bit random base64url
    // (genereras via expo-crypto i appen, ASCII alfanumeriskt + _-).
    // Avvisa allt annat så att path:en inte kan användas till scheme-injection
    // när vi senare lägger in värdet i en tipspromenaden://-URL.
    const m = window.location.pathname.match(/^\/walk\/([a-zA-Z0-9_-]{1,100})\/?$/);
    const walkId = m ? m[1] : null;

    const ua = navigator.userAgent.toLowerCase();
    const isAndroid = /android/.test(ua);
    const isIos = /iphone|ipad|ipod/.test(ua);
    const status = document.getElementById("status");
    const statusEn = document.getElementById("status-en");
    const qrWrap = document.getElementById("qr-wrap");
    const qrImg = document.getElementById("qr-img") as HTMLImageElement | null;

    function setStatus(sv: string, en: string) {
      if (status) status.textContent = sv;
      if (statusEn) statusEn.textContent = en;
    }

    function showQrFor(url: string) {
      if (!qrWrap || !qrImg) return;
      QRCode.toDataURL(url, {
        errorCorrectionLevel: "M",
        width: 560,
        margin: 1,
        color: { dark: "#1B3D2B", light: "#FFFFFF" },
      })
        .then((dataUrl) => {
          qrImg.src = dataUrl;
          // hidden → flex så att gap + items-center från Tailwind aktiveras
          qrWrap.classList.remove("hidden");
          qrWrap.classList.add("flex");
        })
        .catch(() => {
          // Tyst — QR är best-effort, status-texten räcker som fallback.
        });
    }

    if (!walkId) {
      setStatus(
        "Saknar walk-id i länken. Be avsändaren om en ny länk.",
        "The link is missing the walk id. Ask the sender for a new link."
      );
    } else if (isAndroid) {
      // Försök deep-link först, fallback till Play Store om appen
      // inte fångar inom 1.5 s.
      const start = Date.now();
      window.location.href = `tipspromenaden://walk/${encodeURIComponent(walkId)}`;
      setTimeout(() => {
        if (Date.now() - start < 2500) {
          window.location.href = PLAY_STORE;
        }
      }, 1500);
    } else if (isIos) {
      // Samma mönster som Android — försök custom scheme, fallback
      // till App Store om appen inte fångar.
      const start = Date.now();
      window.location.href = `tipspromenaden://walk/${encodeURIComponent(walkId)}`;
      setTimeout(() => {
        if (Date.now() - start < 2500) {
          window.location.href = APP_STORE;
        }
      }, 1500);
    } else {
      // Desktop: visa QR-kod av nuvarande URL så att användaren kan
      // skanna med telefonen. Detta är det vanliga "någon delade en
      // länk i en chatt jag har öppen på datorn"-fallet.
      setStatus(
        "Skanna QR-koden med telefonen för att starta promenaden.",
        "Scan the QR code with your phone to start the walk."
      );
      showQrFor(window.location.href);
    }
  </script>
</Layout>
