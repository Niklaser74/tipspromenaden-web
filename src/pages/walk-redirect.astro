---
import Layout from "../layouts/Layout.astro";

// Statisk catch-all för /walk/<id>-länkar.
//
// Cloudflare _redirects rewrite:ar /walk/* → /walk-redirect.html med
// HTTP 200, så Messenger/iMessage/Slack/Discord får giltigt 200-svar
// med OG-tags och kan visa länkförhandsvisning. Utan den här sidan
// returnerade /walk/<id> 404 (med fallback till 404.astro), och 404
// gör att de flesta sociala plattformar refusar att visa preview.
//
// Sidan extraherar walkId client-side från window.location.pathname
// och försöker:
//  1. Android: deep-link tipspromenaden://walk/<id> (custom scheme).
//     Om appen finns öppnas den; annars fallback till Play Store
//     efter 1.5s.
//  2. iOS: meddelande att iOS-versionen inte är släppt än.
//  3. Desktop: instruktion att öppna länken på Android.
//
// När v1.3.0 är ute hos testarna (intent-filter + assetlinks.json
// verifierat) öppnar Android App Links appen direkt utan att den här
// sidan ens laddas — den blir då bara fallback för icke-installerade.

const title = "Öppnar promenad… — Tipspromenaden";
const description =
  "Du har blivit inbjuden till en tipspromenad. Klicka för att öppna i appen, eller installera Tipspromenaden från Play Store.";
---

<Layout title={title} description={description}>
  <main class="min-h-screen flex flex-col items-center justify-center px-6 text-center">
    <img
      src="/icon.png"
      alt=""
      width="96"
      height="96"
      class="w-24 h-24 rounded-2xl mb-8"
    />

    <h1 class="font-serif text-4xl md:text-5xl text-green-dark mb-4">
      Öppnar promenaden…
    </h1>

    <p id="status" class="text-lg max-w-md mb-4 leading-relaxed">
      Om appen inte öppnas automatiskt skickas du vidare om en stund.
    </p>

    <p id="status-en" class="text-base max-w-md mb-10 leading-relaxed text-text-warm italic">
      If the app doesn't open automatically you'll be redirected
      shortly.
    </p>

    <a href="/" class="text-green font-semibold hover:underline">
      ← Tipspromenaden.app
    </a>
  </main>

  <script>
    const PLAY_STORE =
      "https://play.google.com/store/apps/details?id=com.tipspromenaden.app";

    // Extrahera walkId ur path:en. Format: /walk/<walkId>[/...]
    // Strikt regex som matchar 404.astro — walkId är 96-bit random base64url
    // (genereras via expo-crypto i appen, ASCII alfanumeriskt + _-).
    // Avvisa allt annat så att path:en inte kan användas till scheme-injection
    // när vi senare lägger in värdet i en tipspromenaden://-URL.
    const m = window.location.pathname.match(/^\/walk\/([a-zA-Z0-9_-]{1,100})\/?$/);
    const walkId = m ? m[1] : null;

    const ua = navigator.userAgent.toLowerCase();
    const isAndroid = /android/.test(ua);
    const isIos = /iphone|ipad|ipod/.test(ua);
    const status = document.getElementById("status");
    const statusEn = document.getElementById("status-en");

    function setStatus(sv, en) {
      if (status) status.textContent = sv;
      if (statusEn) statusEn.textContent = en;
    }

    if (!walkId) {
      setStatus(
        "Saknar walk-id i länken. Be avsändaren om en ny länk.",
        "The link is missing the walk id. Ask the sender for a new link."
      );
    } else if (isAndroid) {
      // Försök deep-link först, fallback till Play Store om appen
      // inte fångar inom 1.5 s.
      const start = Date.now();
      window.location.href = `tipspromenaden://walk/${encodeURIComponent(walkId)}`;
      setTimeout(() => {
        if (Date.now() - start < 2500) {
          window.location.href = PLAY_STORE;
        }
      }, 1500);
    } else if (isIos) {
      setStatus(
        "iOS-versionen är inte släppt än. Be skaparen om en Android-installation, eller kom tillbaka när iOS-appen lanseras.",
        "The iOS version isn't released yet. Ask the creator for an Android installation, or come back once the iOS app launches."
      );
    } else {
      setStatus(
        "Öppna länken på en Android-telefon med Tipspromenaden installerad för att starta promenaden.",
        "Open this link on an Android phone with Tipspromenaden installed to start the walk."
      );
    }
  </script>
</Layout>
