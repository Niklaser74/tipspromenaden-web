---
import Layout from "../../layouts/Layout.astro";

// Dynamisk rutt — [id] fångar /walk/<walkId>.
// Returnerar 200 (till skillnad från 404.astro) så länkförhandsvisningar
// i iMessage, Slack, Messenger m.fl. hämtar og:*-taggarna korrekt.
//
// Android App Links: när assetlinks.json är verifierad öppnar OS:et appen
// direkt utan att sidan laddas. Den här sidan är fallback för icke-installerade
// + iOS + desktop.

export const prerender = false; // SSR så att vi kan läsa params vid runtime

const { id } = Astro.params;

const title = "Öppnar promenad… — Tipspromenaden";
const description =
  "Du har blivit inbjuden till en tipspromenad. Öppna länken på en Android-telefon med Tipspromenaden installerad för att starta.";
---

<Layout title={title} description={description}>
  <main class="min-h-screen flex flex-col items-center justify-center px-6 text-center">
    <img
      src="/icon.png"
      alt=""
      width="96"
      height="96"
      class="w-24 h-24 rounded-2xl mb-8"
    />

    <h1 class="font-serif text-4xl md:text-5xl text-green-dark mb-4">
      Öppnar promenaden…
    </h1>

    <p id="status" class="text-lg max-w-md mb-10 leading-relaxed">
      Om appen inte öppnas automatiskt skickas du vidare om en stund.
    </p>

    <a href="/" class="text-green font-semibold hover:underline">
      ← Tipspromenaden.app
    </a>
  </main>

  <script define:vars={{ walkId: id }}>
    const PLAY_STORE =
      "https://play.google.com/store/apps/details?id=com.tipspromenaden.app";

    const ua = navigator.userAgent.toLowerCase();
    const isAndroid = /android/.test(ua);
    const isIos = /iphone|ipad|ipod/.test(ua);
    const status = document.getElementById("status");

    if (isAndroid) {
      const start = Date.now();
      window.location.href = `tipspromenaden://walk/${walkId}`;
      setTimeout(() => {
        if (Date.now() - start < 2500) {
          window.location.href = PLAY_STORE;
        }
      }, 1500);
    } else if (isIos) {
      if (status) {
        status.textContent =
          "iOS-versionen är inte släppt än. Be skaparen om en Android-installation, eller kom tillbaka när iOS-appen lanseras.";
      }
    } else {
      if (status) {
        status.textContent =
          "Öppna länken på en Android-telefon med Tipspromenaden installerad för att starta promenaden.";
      }
    }
  </script>
</Layout>
